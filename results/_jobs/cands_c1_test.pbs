#!/bin/bash
#PBS -N er_cands_
#PBS -q workq
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -o /tmp/ai_25901334/AmazonML/results/_jobs/cands_c1_test.out

exec >> /tmp/ai_25901334/AmazonML/results/_jobs/cands_c1_test.log 2>&1
cd /tmp/ai_25901334/AmazonML
export PYTHONNOUSERSITE=1
export NCPUS=8
export OMP_NUM_THREADS=8
export POLARS_MAX_THREADS=8
export RAYON_NUM_THREADS=8
export PYTHONPATH=/tmp/ai_25901334/AmazonML/pkgs:/tmp/ai_25901334/AmazonML/code
export HF_HOME=/tmp/ai_25901334/AmazonML/hf_cache
export TOKENIZERS_PARALLELISM=false
source /apps/compilers/anaconda3/etc/profile.d/conda.sh
conda activate refused_h100
echo "job $PBS_JOBID on $(hostname) at $(date -Iseconds)"
MIG=""
for try in $(seq 1 120); do MIG=$(python run_h100.py pick-mig 2>/dev/null) && break; MIG=""; echo "no free MIG slice yet (try $try), waiting 60 s"; sleep 60; done
[ -z "$MIG" ] && { echo "no free MIG slice after 2 hours"; exit 3; }
export CUDA_VISIBLE_DEVICES="$MIG"
echo "CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES"
T0=$(date +%s)
python -u code/blocking/build_candidates.py --name c1 --split test --lists emb/e2f:emb:5,blocking/b1:comb:3,blocking/b1:name:2,blocking/b1:addr:2
RC=$?
echo "EXIT rc=$RC after $(( $(date +%s) - T0 )) s at $(date -Iseconds)"
exit $RC
