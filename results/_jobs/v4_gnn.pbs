#!/bin/bash
#PBS -N er_v4_gnn
#PBS -q workq
#PBS -l select=1:ncpus=3:ngpus=1:mem=32gb
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o /tmp/ai_25901334/AmazonML/results/_jobs/v4_gnn.out

exec >> /tmp/ai_25901334/AmazonML/results/_jobs/v4_gnn.log 2>&1
cd /tmp/ai_25901334/AmazonML
export PYTHONNOUSERSITE=1
export NCPUS=3
export OMP_NUM_THREADS=3
export POLARS_MAX_THREADS=3
export RAYON_NUM_THREADS=3
export PYTHONPATH=/tmp/ai_25901334/AmazonML/pkgs:/tmp/ai_25901334/AmazonML/code
export HF_HOME=/tmp/ai_25901334/AmazonML/hf_cache
export TOKENIZERS_PARALLELISM=false
source /apps/compilers/anaconda3/etc/profile.d/conda.sh
conda activate refused_h100
export ER_NORM=v2
export ER_CACHE=data/cache_v2
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
echo "job $PBS_JOBID on $(hostname) at $(date -Iseconds); PBS CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-unset}"
export PBS_CUDA_ORIG="${CUDA_VISIBLE_DEVICES:-unset}"
MIG=""
sleep $((RANDOM % 20)); for try in $(seq 1 120); do MIG=$(python run_h100.py pick-mig 2>/dev/null) && break; MIG=""; echo "no free MIG slice yet (try $try), waiting 60 s"; sleep 60; done
[ -z "$MIG" ] && { echo "no free MIG slice after 2 hours"; exit 3; }
export CUDA_VISIBLE_DEVICES="$MIG"
echo "CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES"
trap "rm -f /tmp/ai_25901334/AmazonML/results/_jobs/mig_locks/$MIG" EXIT
# all our jobs were SIGKILLed at 10:45:01 and 12:44:02 (every 2 h at ~:44, cause not visible to us):
# if the expected run would cross the next such window, wait until it has passed
EXPECT=50
M=$(( 10#$(date +%H) * 60 + 10#$(date +%M) )); TO=$(( (44 - M % 120 + 120) % 120 ))
if [ $TO -lt $((EXPECT + 2)) ]; then W=$(( (TO + 3) * 60 )); echo "waiting ${W}s to skip the :44 window"; sleep $W; fi
T0=$(date +%s)
bash -c 'set -e; python -u code/gnn/edge_gnn.py --tag gnn_mlx_v2 --batch_s1 1500 --feats c2_train_sim19 --split train --score_only --halves B --s1 oof_chainB_s1.parquet --extra xenc/chainB_train_extra.parquet:mlxenc --out_tag chainB; python -u code/gnn/edge_gnn.py --tag gnn_mlx_v2 --batch_s1 1500 --feats c2_train_sim19 --split train --score_only --halves A,B --s1 oof_chainR_s1.parquet --extra xenc/chainR_train_extra.parquet:mlxenc --out_tag chainR; python -u code/gnn/edge_gnn.py --tag gnn_mlx_v2 --batch_s1 1500 --feats c2_test --split test --halves A --s1 test_stage1_halfA_v2.parquet --extra xenc/chainA_test_extra.parquet:mlxenc --out_tag chainA; python -u code/gnn/edge_gnn.py --tag gnn_mlx_v2 --batch_s1 1500 --feats c2_test --split test --halves B --s1 test_stage1_halfB_v2.parquet --extra xenc/chainB_test_extra.parquet:mlxenc --out_tag chainB; python -u code/final/chain_v4.py evaluate'
RC=$?
echo "EXIT rc=$RC after $(( $(date +%s) - T0 )) s at $(date -Iseconds)"
exit $RC
