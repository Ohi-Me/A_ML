#!/bin/bash
#PBS -N er_loco_i
#PBS -q workq
#PBS -l select=1:ncpus=3:ngpus=1:mem=32gb
#PBS -l walltime=03:00:00
#PBS -j oe
#PBS -o /tmp/ai_25901334/AmazonML/results/_jobs/loco_in.out

exec >> /tmp/ai_25901334/AmazonML/results/_jobs/loco_in.log 2>&1
cd /tmp/ai_25901334/AmazonML
export PYTHONNOUSERSITE=1
export NCPUS=3
export OMP_NUM_THREADS=3
export POLARS_MAX_THREADS=3
export RAYON_NUM_THREADS=3
export PYTHONPATH=/tmp/ai_25901334/AmazonML/pkgs:/tmp/ai_25901334/AmazonML/code
export HF_HOME=/tmp/ai_25901334/AmazonML/hf_cache
export TOKENIZERS_PARALLELISM=false
source /apps/compilers/anaconda3/etc/profile.d/conda.sh
conda activate refused_h100
export ER_NORM=v2
export ER_CACHE=data/cache_v2
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
echo "job $PBS_JOBID on $(hostname) at $(date -Iseconds); PBS CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-unset}"
export PBS_CUDA_ORIG="${CUDA_VISIBLE_DEVICES:-unset}"
MIG=""
sleep $((RANDOM % 20)); for try in $(seq 1 120); do MIG=$(python run_h100.py pick-mig 2>/dev/null) && break; MIG=""; echo "no free MIG slice yet (try $try), waiting 60 s"; sleep 60; done
[ -z "$MIG" ] && { echo "no free MIG slice after 2 hours"; exit 3; }
export CUDA_VISIBLE_DEVICES="$MIG"
echo "CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES"
trap "rm -f /tmp/ai_25901334/AmazonML/results/_jobs/mig_locks/$MIG" EXIT
# all our jobs were SIGKILLed at 10:45:01 and 12:44:02 (every 2 h at ~:44, cause not visible to us):
# if the expected run would cross the next such window, wait until it has passed
EXPECT=110
M=$(( 10#$(date +%H) * 60 + 10#$(date +%M) )); TO=$(( (44 - M % 120 + 120) % 120 ))
if [ $TO -lt $((EXPECT + 2)) ]; then W=$(( (TO + 3) * 60 )); echo "waiting ${W}s to skip the :44 window"; sleep $W; fi
T0=$(date +%s)
bash -c 'set -e; python -u code/xgboost/train_xgb.py --feats c2_train_sim19 --tag loco_in_noemb --simdrop 19 --fit_country India --drop cos_e3,b_gap_cos_e3,b_rank_cos_e3,a_gap_cos_e3,a_rank_cos_e3,b_gap2_cos_e3,r_e3_emb; python -u code/neural_reranker/prep_pairs.py --split train --scores oof_loco_in_noemb.parquet --name locoin --raw --maxlen 110; python -u code/neural_reranker/ml_cross_encoder.py --name locoin --split train --epochs 2 --fit_country India; python -u code/gnn/edge_gnn.py --feats c2_train_sim19 --s1 oof_loco_in_noemb.parquet --fit_country India --drop_feats cos_e3 --batch_s1 1500 --tag loco_in_gnn; python -u code/gnn/make_oof.py oof_loco_in_noemb.parquet gnn/loco_in_gnn_train_scores.parquet loco_in_gnn; python -u code/gnn/edge_gnn.py --feats c2_train_sim19 --s1 oof_loco_in_noemb.parquet --fit_country India --drop_feats cos_e3 --batch_s1 1500 --tag loco_in_gnnx --extra xenc/ml_locoin_train_scores.parquet:mlxenc; python -u code/gnn/make_oof.py oof_loco_in_noemb.parquet gnn/loco_in_gnnx_train_scores.parquet loco_in_gnnx; python -u code/audit/loco_eval.py --systems s1:oof_loco_in_noemb.parquet,gnn:oof_loco_in_gnn.parquet,gnnx:oof_loco_in_gnnx.parquet,seen_s1:oof_xgb_c2_sim19_noemb_v2.parquet,seen_v3:oof_gnn_mlx_v2.parquet'
RC=$?
echo "EXIT rc=$RC after $(( $(date +%s) - T0 )) s at $(date -Iseconds)"
exit $RC
